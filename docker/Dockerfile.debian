# Dockerfile for accord testing on Debian Bookworm
#
# This image includes:
# - Debian Bookworm (slim)
# - Zig 0.17.1 (aarch64-linux or x86_64-linux, matching the build host)
# - Git (for future use)
#
# Build: docker build -t accord-test:debian -f docker/Dockerfile.debian .
# Run:   docker run -it --rm -v $(pwd):/workspace accord-test:debian

# Stage 1: Download, verify and extract Zig
FROM debian:bookworm-slim AS zig-installer

# Keep in sync with mise.toml
ARG ZIG_VERSION=0.17.1
# SHA-256 checksums from https://ziglang.org/download/index.json
ARG ZIG_SHA256_AARCH64=a1546d5646eb184437918d6635ca6b762a0e889eac09cef720ee7a1ed3fe7795
ARG ZIG_SHA256_X86_64=3581863e3cbcfd0fce0efc682ce7e9e93da96668a977791d356a26d2a7e9b17a

# Install dependencies for downloading and extracting
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Download and extract Zig for the host architecture
WORKDIR /tmp
RUN set -eu; \
    arch="$(uname -m)"; \
    case "$arch" in \
        aarch64) sha256="$ZIG_SHA256_AARCH64" ;; \
        x86_64)  sha256="$ZIG_SHA256_X86_64" ;; \
        *) echo "Unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://ziglang.org/download/${ZIG_VERSION}/zig-${arch}-linux-${ZIG_VERSION}.tar.xz" -o zig.tar.xz; \
    echo "${sha256}  zig.tar.xz" | sha256sum -c -; \
    tar -xf zig.tar.xz; \
    mv "zig-${arch}-linux-${ZIG_VERSION}" /usr/local/zig; \
    rm zig.tar.xz

# Verify Zig installation
RUN /usr/local/zig/zig version

# Stage 2: Runtime image
FROM debian:bookworm-slim

# Copy Zig from builder stage
COPY --from=zig-installer /usr/local/zig /usr/local/zig

# Install runtime dependencies
# - git: for future version control operations
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create symlink for easy access
RUN ln -s /usr/local/zig/zig /usr/bin/zig

# Verify Zig is accessible
RUN zig version

# Set working directory
WORKDIR /workspace

# Default command
CMD ["/bin/bash"]
