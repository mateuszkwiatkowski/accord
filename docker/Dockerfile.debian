# Dockerfile for accord testing on Debian Bookworm
#
# This image includes:
# - Debian Bookworm (slim)
# - Zig 0.15.2 (aarch64-linux)
# - Git (for future use)
#
# Build: docker build -t accord-test:debian -f docker/Dockerfile.debian .
# Run:   docker run -it --rm -v $(pwd):/workspace accord-test:debian

# Stage 1: Download and extract Zig
FROM debian:bookworm-slim AS zig-installer

# Install dependencies for downloading and extracting
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Download and extract Zig 0.15.2 for aarch64-linux
# Using specific version to match development environment
WORKDIR /tmp
RUN curl -L https://ziglang.org/download/0.15.2/zig-aarch64-linux-0.15.2.tar.xz -o zig.tar.xz \
    && tar -xf zig.tar.xz \
    && mv zig-aarch64-linux-0.15.2 /usr/local/zig \
    && rm zig.tar.xz

# Verify Zig installation
RUN /usr/local/zig/zig version

# Stage 2: Runtime image
FROM debian:bookworm-slim

# Copy Zig from builder stage
COPY --from=zig-installer /usr/local/zig /usr/local/zig

# Install runtime dependencies
# - git: for future version control operations
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create symlink for easy access
RUN ln -s /usr/local/zig/zig /usr/bin/zig

# Verify Zig is accessible
RUN zig version

# Set working directory
WORKDIR /workspace

# Default command
CMD ["/bin/bash"]
